#!/usr/bin/env bash
# Start the PostgreSQL that Gates P and I measure a release on, on this machine:
# the image CI's service pins, by the same digest, made with the C collation the
# store needs (ADR-0213), with PostgreSQL's default settings and its data on the
# disk, as a deployment's database keeps it. No port is published: the service
# reaches the database at the container's own address, since Docker's userland
# port proxy, which a published port puts between the two, made 0.5.3's and
# 0.5.2's writes miss Gate P where both passed reached directly (TODO, 0.5.3's
# Gates P and I, 2026-10-24). The address is the default bridge's, which a Linux
# host reaches; Docker Desktop's is not reachable from its host. Run again, it
# starts the database afresh.
#
# Usage: scripts/setup/postgres-gate-db
#   then give scripts/profile/build-store.py, idle.py and load.py the URL it
#   prints, a database of your own named in its path, its password in
#   OBJECTFLOW_STORE_PASSWORD=objectflow; and docker stop objectflow-gate-db,
#   which removes it and its data.
set -euo pipefail
name=objectflow-gate-db
# the digest .github/workflows/check.yml pins, read from it so the two cannot
# drift apart
workflow="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/.github/workflows/check.yml"
image=$(sed -n 's/.*image: \(postgres@sha256:[0-9a-f]*\).*/\1/p' "$workflow")
if [ -z "$image" ]; then
  echo "postgres-gate-db: no pinned postgres image in $workflow" >&2
  exit 1
fi
docker rm -f "$name" >/dev/null 2>&1 || true
docker run -d --rm --name "$name" \
  -e POSTGRES_USER=objectflow -e POSTGRES_PASSWORD=objectflow -e POSTGRES_DB=objectflow \
  -e POSTGRES_INITDB_ARGS="--locale=C --encoding=UTF8" "$image" >/dev/null
# ready on TCP only once initialisation's own server, on its socket alone, has
# stopped and the database's has started
for _ in $(seq 1 60); do
  if docker exec "$name" pg_isready -U objectflow -h localhost >/dev/null 2>&1; then
    address=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$name")
    echo "postgresql://objectflow@$address:5432/<database>"
    exit 0
  fi
  sleep 1
done
echo "postgres-gate-db: $name not ready after 60 s" >&2
exit 1
