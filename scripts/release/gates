#!/usr/bin/env bash
# Gates P and I on both backends for a release build (audit/cost.md §3,
# ADR-0214 decision 2): a two-year profile store built by the build on each
# backend with build-store.py's defaults; Gate I on each; Gate P at scales 1 and
# 2 on each. PostgreSQL is the database scripts/setup/postgres-gate-db starts,
# reached at the container's address, each Gate P run on a fresh copy of the
# built store, since its writes are kept, the copy marked as operate.md says.
#
# A run that other work shared exits 3, not decided, and is run again
# (ADR-0235, ADR-0236), three attempts at most. Before each attempt the script
# waits for the machine's 1-minute load to fall under 1.0, checked every 20 s,
# for at most --wait seconds; the run's own sampler still decides the run. Each
# attempt's output is kept as <work>/<run>.log.<attempt>, and a line per attempt
# is printed. Gate P's figures and each miss are the run's; whether a miss is one
# a decision accepts by name is the release record's to say (TODO.md, F).
#
# Usage: scripts/release/gates <objectflow-service> <work dir> [options]
#   --runs <run,...>   among sqlite-i sqlite-1 sqlite-2 pg-i pg-1 pg-2 (all)
#   --reuse            take <work>/base.sqlite and a running gate database's
#                      store `base` where they are there, built by this build
#   --keep             leave the stores and the gate database at the end
#   --wait <seconds>   the longest wait for a quiet machine (10800)
#   --claims <n> --employees <n> --seconds <n>
#                      a smaller store or a shorter Gate P run, to check this
#                      script; a result on them is not the gate's
# Exits 0 where every run was decided and passed, 1 where a run failed, 3 where
# a run stayed undecided after its attempts or no quiet machine came.
set -uo pipefail
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
PY=$ROOT/scripts/.venv/bin/python
BIN=${1:?usage: scripts/release/gates <objectflow-service> <work dir> [options]}
mkdir -p "${2:?usage: scripts/release/gates <objectflow-service> <work dir> [options]}"
W=$(cd "$2" && pwd)
shift 2
RUNS=sqlite-i,sqlite-1,sqlite-2,pg-i,pg-1,pg-2 REUSE=0 KEEP=0 WAIT=10800
STORE_ARGS=() LOAD_ARGS=()
while [ $# -gt 0 ]; do
  case $1 in
    --runs) RUNS=$2; shift 2 ;;
    --reuse) REUSE=1; shift ;;
    --keep) KEEP=1; shift ;;
    --wait) WAIT=$2; shift 2 ;;
    --claims|--employees) STORE_ARGS+=("$1" "$2"); shift 2 ;;
    --seconds) LOAD_ARGS+=("$1" "$2"); shift 2 ;;
    *) echo "gates: unknown option $1" >&2; exit 2 ;;
  esac
done
export OBJECTFLOW_STORE_PASSWORD=objectflow
DB=objectflow-gate-db
psql_() { docker exec "$DB" psql -q -tA -U objectflow -d "${2:-postgres}" -c "$1"; }
quiet() {
  local waited=0 l
  while :; do
    l=$(cut -d' ' -f1 /proc/loadavg)
    if awk "BEGIN {exit !($l < 1.0)}"; then
      echo "   start load $(cut -d' ' -f1-3 /proc/loadavg), after $waited s waiting"; return 0
    fi
    [ "$waited" -ge "$WAIT" ] && { echo "   no quiet machine in $WAIT s: load $(cut -d' ' -f1-3 /proc/loadavg)"; return 1; }
    sleep 20; waited=$((waited + 20))
  done
}
copy() {   # a Gate P run's fresh copy of the built PostgreSQL store, marked as operate.md says
  psql_ "DROP DATABASE IF EXISTS $1" && psql_ "CREATE DATABASE $1 TEMPLATE base" &&
    psql_ "INSERT INTO of_counter (name, value) VALUES ('copied', 1) ON CONFLICT (name) DO UPDATE SET value = 1" "$1"
}
worst=0
gate() {   # run name, PostgreSQL copy or "", command...: attempts while not decided
  local run=$1 db=$2 n rc=3
  shift 2
  for n in 1 2 3; do
    quiet || { rc=3; break; }
    if [ -n "$db" ]; then copy "$db" || { echo "   $run: no copy of the store"; rc=1; break; }; fi
    "$@" > "$W/$run.log.$n" 2>&1
    rc=$?
    echo "   $run attempt $n exit $rc: $(grep -E '^(MISSED|FAILED|UNDECIDED)|^Gate [IP]: (passed|failed|not decided)' "$W/$run.log.$n" | tr '\n' ' ' | cut -c1-300)"
    [ "$rc" -ne 3 ] && break
  done
  if [ "$rc" -eq 1 ] || { [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ]; }; then worst=1
  elif [ "$rc" -eq 3 ] && [ "$worst" -eq 0 ]; then worst=3; fi
}
wants() { case ",$RUNS," in *",$1,"*) return 0 ;; *) return 1 ;; esac; }
"$BIN" --version
if wants sqlite-i || wants sqlite-1 || wants sqlite-2; then
  if [ "$REUSE" = 1 ] && [ -f "$W/base.sqlite" ]; then
    echo "== the SQLite store kept in $W"
  else
    echo "== build SQLite $(date +%T)"
    rm -f "$W"/base.sqlite*
    "$PY" "$ROOT/scripts/profile/build-store.py" "$BIN" "$W/base.sqlite" "${STORE_ARGS[@]}" > "$W/build-sqlite.log" 2>&1 ||
      { echo "   the SQLite store was not built: $(tail -1 "$W/build-sqlite.log")"; exit 1; }
    echo "   $(tail -1 "$W/build-sqlite.log" | cut -c1-200)"
  fi
  wants sqlite-i && { echo "== Gate I SQLite $(date +%T)"; gate sqlite-i "" "$PY" "$ROOT/scripts/profile/idle.py" "$BIN" "$W/base.sqlite"; }
  for s in 1 2; do
    wants sqlite-$s && { echo "== Gate P SQLite scale $s $(date +%T)"
      gate sqlite-$s "" "$PY" "$ROOT/scripts/profile/load.py" "$BIN" "$W/base.sqlite" --scale $s "${LOAD_ARGS[@]}"; }
  done
fi
if wants pg-i || wants pg-1 || wants pg-2; then
  if [ "$REUSE" = 1 ] && [ "$(psql_ "SELECT 1 FROM pg_database WHERE datname = 'base'" 2>/dev/null)" = 1 ]; then
    CIP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$DB")
    echo "== the running gate database's store, at $CIP"
  else
    echo "== build PostgreSQL $(date +%T)"
    CIP=$("$ROOT/scripts/setup/postgres-gate-db" 2>&1 | tail -1 | grep -oE '([0-9]+\.){3}[0-9]+' | head -1)
    [ -n "$CIP" ] || { echo "   no gate database"; exit 1; }
    psql_ "CREATE DATABASE base"
    "$PY" "$ROOT/scripts/profile/build-store.py" "$BIN" "postgresql://objectflow@$CIP:5432/base" "${STORE_ARGS[@]}" \
      > "$W/build-pg.log" 2>&1 || { echo "   the PostgreSQL store was not built: $(tail -1 "$W/build-pg.log")"; exit 1; }
    echo "   $(tail -1 "$W/build-pg.log" | cut -c1-200)"
  fi
  wants pg-i && { echo "== Gate I PostgreSQL $(date +%T)"
    gate pg-i gi "$PY" "$ROOT/scripts/profile/idle.py" "$BIN" "postgresql://objectflow@$CIP:5432/gi"; }
  for s in 1 2; do
    wants pg-$s && { echo "== Gate P PostgreSQL scale $s $(date +%T)"
      gate pg-$s "gp$s" "$PY" "$ROOT/scripts/profile/load.py" "$BIN" "postgresql://objectflow@$CIP:5432/gp$s" \
        --scale $s "${LOAD_ARGS[@]}"; }
  done
fi
if [ "$KEEP" = 0 ]; then
  rm -f "$W"/base.sqlite*
  docker stop "$DB" >/dev/null 2>&1
fi
echo "== done $(date +%T), exit $worst"
exit "$worst"
