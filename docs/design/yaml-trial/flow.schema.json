{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "objectflow-flow-trial",
  "title": "An ObjectFlow module, written as structured YAML (specified in docs/design/flow-format.md)",
  "description": "A module names itself, may import types from other modules, declares its enumerations, and declares each type under `types`.",
  "type": "object",
  "required": ["module", "categories", "types"],
  "additionalProperties": false,
  "properties": {
    "module": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "imports": {
      "description": "Types used from other modules, by module name.",
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"$ref": "#/definitions/typeName"}}
    },
    "categories": {
      "description": "The state categories the module's states use, such as live and closed.",
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/definitions/memberName"}
    },
    "enumerations": {
      "description": "Named sets of values. A value is written qualified, as Condition.DAMAGED.",
      "type": "object",
      "propertyNames": {"$ref": "#/definitions/typeName"},
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/stateName"}}
    },
    "types": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/definitions/typeName"},
      "additionalProperties": {"$ref": "#/definitions/type"}
    }
  },
  "definitions": {
    "typeName": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
    "stateName": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "memberName": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "names": {"type": "array", "items": {"$ref": "#/definitions/memberName"}},
    "states": {
      "oneOf": [
        {"$ref": "#/definitions/stateName"},
        {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/stateName"}}
      ]
    },
    "description": {"type": "string", "minLength": 3},
    "duration": {"type": "string", "pattern": "^[0-9]+ (s|min|h|days?|weeks?)$"},
    "expression": {"type": "string", "minLength": 1},
    "remedy": {"enum": ["self_serviceable", "delegable", "temporal", "dependent", "unreachable_from_here"]},
    "type": {
      "type": "object",
      "required": ["description", "tracking", "states", "transitions"],
      "additionalProperties": false,
      "properties": {
        "description": {"$ref": "#/definitions/description"},
        "tracking": {"enum": ["record", "serial", "quantity"]},
        "states": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/definitions/stateName"},
          "additionalProperties": {"$ref": "#/definitions/state"}
        },
        "transitions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/definitions/memberName"},
          "additionalProperties": {"$ref": "#/definitions/transition"}
        },
        "conditions": {
          "description": "Named conditions, used as guards by the transitions.",
          "type": "object",
          "propertyNames": {"$ref": "#/definitions/memberName"},
          "additionalProperties": {"$ref": "#/definitions/condition"}
        },
        "invariants": {
          "description": "Conditions that hold for every object of the type at all times.",
          "type": "object",
          "propertyNames": {"$ref": "#/definitions/memberName"},
          "additionalProperties": {"$ref": "#/definitions/invariant"}
        },
        "attributes": {
          "type": "object",
          "propertyNames": {"$ref": "#/definitions/memberName"},
          "additionalProperties": {"$ref": "#/definitions/attribute"}
        },
        "observations": {
          "type": "object",
          "propertyNames": {"$ref": "#/definitions/memberName"},
          "additionalProperties": {"$ref": "#/definitions/observation"}
        },
        "metrics": {
          "type": "object",
          "propertyNames": {"$ref": "#/definitions/memberName"},
          "additionalProperties": {"$ref": "#/definitions/metric"}
        }
      }
    },
    "state": {
      "type": "object",
      "required": ["category"],
      "additionalProperties": false,
      "properties": {
        "description": {"$ref": "#/definitions/description"},
        "category": {"$ref": "#/definitions/memberName"},
        "final": {"type": "boolean", "description": "No transition leaves this state (UML FinalState)."},
        "required_attributes": {"$ref": "#/definitions/names", "description": "Attributes that have a value whenever an object is in this state."}
      }
    },
    "transition": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["initial", "external", "internal"], "description": "UML: initial transition, external transition, internal transition."},
        "from": {"$ref": "#/definitions/states"},
        "to": {"$ref": "#/definitions/stateName"},
        "description": {"$ref": "#/definitions/description"},
        "required_inputs": {"$ref": "#/definitions/names", "description": "Attributes the caller must supply; each is written to the attribute of the same name."},
        "optional_inputs": {"$ref": "#/definitions/names", "description": "Attributes the caller may supply; each is written if supplied."},
        "guards": {
          "description": "Conditions evaluated, in this order, after the required inputs are checked.",
          "type": "object",
          "propertyNames": {"$ref": "#/definitions/memberName"},
          "additionalProperties": {"enum": ["deny", "audit", "warn"]}
        },
        "effect": {
          "description": "The writes the transition makes, in this order (UML Transition::effect).",
          "type": "array",
          "items": {"$ref": "#/definitions/step"}
        },
        "backdating_limit": {"$ref": "#/definitions/duration"}
      },
      "additionalProperties": false,
      "oneOf": [
        {"properties": {"kind": {"const": "initial"}}, "required": ["to"], "not": {"required": ["from"]}},
        {"properties": {"kind": {"const": "external"}}, "required": ["from", "to"]},
        {"properties": {"kind": {"const": "internal"}}, "required": ["from"], "not": {"required": ["to"]}}
      ]
    },
    "step": {
      "oneOf": [
        {
          "type": "object", "required": ["assign"], "additionalProperties": false,
          "properties": {"assign": {
            "description": "Writes the value of expr to the attribute named by location (SCXML <assign>).",
            "type": "object", "required": ["location", "expr"], "additionalProperties": false,
            "properties": {"location": {"$ref": "#/definitions/memberName"}, "expr": {"$ref": "#/definitions/expression"}}
          }}
        },
        {
          "type": "object", "required": ["clear"], "additionalProperties": false,
          "properties": {"clear": {"$ref": "#/definitions/names"}}
        }
      ]
    },
    "condition": {
      "type": "object",
      "required": ["description", "expression", "remedy"],
      "additionalProperties": false,
      "properties": {
        "description": {"$ref": "#/definitions/description"},
        "expression": {"$ref": "#/definitions/expression"},
        "remedy": {"$ref": "#/definitions/remedy"}
      }
    },
    "invariant": {
      "type": "object",
      "required": ["description", "expression"],
      "additionalProperties": false,
      "properties": {
        "description": {"$ref": "#/definitions/description"},
        "expression": {"$ref": "#/definitions/expression"}
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\([A-Za-z0-9, ]+\\))?(\\[\\])?$"},
        "reference": {"$ref": "#/definitions/typeName"},
        "description": {"$ref": "#/definitions/description"},
        "optional": {"type": "boolean"},
        "unique": {"type": "boolean"},
        "indexed": {"type": "boolean"},
        "personal": {"type": "boolean"},
        "actor_kind": {"enum": ["human", "agent", "service"]},
        "assignee": {"type": "boolean"},
        "unit": {"type": "string"}
      },
      "oneOf": [{"required": ["type"]}, {"required": ["reference"]}]
    },
    "observation": {
      "type": "object",
      "required": ["kind", "description", "attributes"],
      "additionalProperties": false,
      "properties": {
        "kind": {"$ref": "#/definitions/typeName"},
        "description": {"$ref": "#/definitions/description"},
        "attributes": {
          "type": "object",
          "propertyNames": {"$ref": "#/definitions/memberName"},
          "additionalProperties": {"$ref": "#/definitions/attribute"}
        },
        "max_recording_delay": {"$ref": "#/definitions/duration"},
        "invariants": {
          "type": "object",
          "propertyNames": {"$ref": "#/definitions/memberName"},
          "additionalProperties": {"$ref": "#/definitions/invariant"}
        }
      }
    },
    "metric": {
      "type": "object",
      "required": ["description", "measure"],
      "additionalProperties": false,
      "properties": {
        "description": {"$ref": "#/definitions/description"},
        "measure": {"enum": ["median_time_in_state", "transition_count"]},
        "state": {"$ref": "#/definitions/stateName"},
        "transition": {"$ref": "#/definitions/memberName"},
        "group_by": {"$ref": "#/definitions/names", "description": "month, week, actor, or an attribute of the type."},
        "flag_when": {
          "type": "object",
          "propertyNames": {"$ref": "#/definitions/memberName"},
          "additionalProperties": {"$ref": "#/definitions/expression"}
        }
      },
      "oneOf": [
        {"properties": {"measure": {"const": "median_time_in_state"}}, "required": ["state"], "not": {"required": ["transition"]}},
        {"properties": {"measure": {"const": "transition_count"}}, "required": ["transition"], "not": {"required": ["state"]}}
      ]
    }
  }
}
