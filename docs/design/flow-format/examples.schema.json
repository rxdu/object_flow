{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "examples.schema.json",
  "title": "ObjectFlow examples file (format 1)",
  "description": "The examples a flow description carries: named setups, each a sequence of requests and imports from an empty store, and examples, each a request and what it must do (flow-format.md §11, ADR-0136).",
  "type": "object",
  "required": ["examples_for", "examples"],
  "additionalProperties": false,
  "properties": {
    "examples_for": {
      "description": "The module whose rules these examples exercise.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "setups": {
      "description": "Named starting states, each built by requests from an empty store, so every state an example starts from is one the flow can reach.",
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/exampleName" },
      "additionalProperties": { "$ref": "#/definitions/setup" }
    },
    "examples": {
      "description": "Each a request made from a setup's state, and the verdict, or the state reached, it must give.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/definitions/exampleName" },
      "additionalProperties": { "$ref": "#/definitions/example" }
    }
  },
  "definitions": {
    "exampleName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "alias": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "duration": { "type": "string", "pattern": "^[0-9]+ (s|min|h|days?|weeks?)$" },
    "evaluators": {
      "description": "The answer each named evaluator function gives, stubbed, since an example never calls another system.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
      "additionalProperties": { "enum": ["satisfied", "unsatisfied", "unanswered"] }
    },
    "setup": {
      "type": "object",
      "required": ["description", "steps"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "given": { "$ref": "#/definitions/exampleName" },
        "evaluators": { "$ref": "#/definitions/evaluators" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/step" } }
      }
    },
    "example": {
      "type": "object",
      "required": ["description", "expect"],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["request"], "not": { "required": ["approve"] } },
        { "required": ["approve"], "not": { "required": ["request"] } }
      ],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "given": { "$ref": "#/definitions/exampleName" },
        "evaluators": { "$ref": "#/definitions/evaluators" },
        "steps": { "type": "array", "items": { "$ref": "#/definitions/step" } },
        "request": { "$ref": "#/definitions/request" },
        "approve": { "$ref": "#/definitions/decision" },
        "expect": { "$ref": "#/definitions/expect" }
      }
    },
    "step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "request": { "$ref": "#/definitions/request" },
        "import": { "$ref": "#/definitions/import" },
        "publish": { "$ref": "#/definitions/publish" },
        "propose": { "$ref": "#/definitions/propose" },
        "approve": { "$ref": "#/definitions/decision" },
        "reject": { "$ref": "#/definitions/decision" },
        "withdraw": { "$ref": "#/definitions/decision" }
      }
    },
    "request": {
      "description": "A creation names its type; any other request names the object, by the alias an earlier step gave it.",
      "type": "object",
      "required": ["transition"],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["type"], "not": { "required": ["object"] } },
        { "required": ["object"], "not": { "anyOf": [{ "required": ["type"] }, { "required": ["as"] }] } }
      ],
      "properties": {
        "type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "object": { "$ref": "#/definitions/alias" },
        "transition": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "as": { "$ref": "#/definitions/alias" },
        "creates": {
          "description": "Aliases for the objects the request's effect creates, other than its own, in the order it creates them: a list, of objects of one type, or a mapping from each type to the aliases of its objects (ADR-0173 decision 6).",
          "oneOf": [
            { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/alias" } },
            {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^[A-Z][A-Za-z0-9]*$" },
              "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/alias" } }
            }
          ]
        },
        "actor": { "$ref": "#/definitions/alias" },
        "after": { "$ref": "#/definitions/duration" },
        "occurred_at": {
          "description": "When the request says the change happened: a timestamp, such as now - 1 day, held to the transition's backdating_limit or the kind's max_recording_delay.",
          "type": "string"
        },
        "inputs": { "type": "object" }
      }
    },
    "propose": {
      "description": "A request filed as a proposal instead of executed, on a transition marked proposable; `proposal` names the proposal for the steps after it (DESIGN.md §9).",
      "type": "object",
      "required": ["transition", "proposal"],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["type"], "not": { "required": ["object"] } },
        { "required": ["object"], "not": { "required": ["type"] } }
      ],
      "properties": {
        "type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "object": { "$ref": "#/definitions/alias" },
        "transition": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "proposal": { "$ref": "#/definitions/alias" },
        "actor": { "$ref": "#/definitions/alias" },
        "after": { "$ref": "#/definitions/duration" },
        "occurred_at": {
          "description": "When the proposed change happened, held to the transition's backdating_limit when the proposal is filed.",
          "type": "string"
        },
        "inputs": { "type": "object" }
      }
    },
    "decision": {
      "description": "Approves, rejects or withdraws a pending proposal an earlier step filed; approving executes its request as the approver, and a refusal leaves it pending (DESIGN.md §9).",
      "type": "object",
      "required": ["proposal"],
      "additionalProperties": false,
      "properties": {
        "proposal": { "$ref": "#/definitions/alias" },
        "actor": { "$ref": "#/definitions/alias" },
        "after": { "$ref": "#/definitions/duration" }
      }
    },
    "import": {
      "description": "An object of a mirror type, written by the import, the one route into a mirror.",
      "type": "object",
      "required": ["type", "as", "state"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "as": { "$ref": "#/definitions/alias" },
        "state": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "values": { "type": "object" },
        "sequences": {
          "description": "Each sequence raised past the last number a legacy system minted from it, in its scope where it is scoped, as an import raises it (publish-and-import.md §4, ADR-0173 decision 6).",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sequence", "last"],
            "additionalProperties": false,
            "properties": {
              "sequence": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "last": { "type": "integer", "minimum": 0 },
              "scope": {}
            }
          }
        },
        "after": { "$ref": "#/definitions/duration" }
      }
    },
    "publish": {
      "description": "Another version installed over the example's store: a change drafted with the files named, each beside the examples file and keyed by the name it declares, submitted and approved as the actor, the operator by default (ADR-0166).",
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*\\.yaml$" }
        },
        "actor": { "$ref": "#/definitions/alias" },
        "after": { "$ref": "#/definitions/duration" }
      }
    },
    "expect": {
      "type": "object",
      "required": ["verdict"],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": ["applied", "unsatisfied", "unavailable", "invalid_input", "not_requestable",
                   "over_limit", "invariant_violated", "call_refused"]
        },
        "clause": { "type": "string", "pattern": "^([A-Z][A-Za-z0-9]*\\.)?[a-z][a-z0-9_]*$" },
        "remedy": {
          "enum": ["self_serviceable", "delegable", "temporal", "dependent", "unreachable_from_here"]
        },
        "state": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "values": { "type": "object" },
        "cascaded": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*\\.[a-z][a-z0-9_]*$" }
        },
        "warned": {
          "description": "The warn guards an applied request raised, in the order they were decided: the transition's own by name, a caused transition's qualified by its type.",
          "type": "array",
          "items": { "type": "string", "pattern": "^([A-Z][A-Za-z0-9]*\\.)?[a-z][a-z0-9_]*$" }
        },
        "occurred_at": {
          "description": "For applied: the occurred time the request recorded, a timestamp such as now - 1 day.",
          "type": "string"
        },
        "metrics": {
          "description": "What metrics read after the request, by the name a reader reads each by: its value over every row, keeping no dimension, or its rows by every dimension it declares, each its dimensions' values and its value (ADR-0173 decision 6).",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^([A-Z][A-Za-z0-9]*\\.)?[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$" },
          "additionalProperties": {
            "oneOf": [
              { "type": ["string", "number", "boolean", "null"] },
              { "type": "array", "items": { "type": "object", "required": ["value"] } }
            ]
          }
        },
        "proposal": {
          "description": "The state an approved proposal is left in: executed where its request applied, pending where it was refused, and as it was where it was not pending, invalidated included.",
          "enum": ["pending", "executed", "rejected", "withdrawn", "invalidated"]
        }
      }
    }
  }
}
