{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "objectflow-flow-description-draft-2.schema.json",
  "title": "ObjectFlow flow description (draft 2)",
  "description": "The structure of a flow description, the one written form of an ObjectFlow flow (ADR-0116). Normative for structure only: the rules this schema cannot express, and the meaning of every key, are in docs/design/flow-format.md, and scripts/check-flows.py checks them all.",
  "type": "object",
  "required": [
    "module",
    "categories",
    "types"
  ],
  "additionalProperties": false,
  "properties": {
    "module": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "imports": {
      "description": "Types used from other modules, by module name.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/typeName"
        }
      }
    },
    "categories": {
      "description": "The state categories the module's states use, such as live and closed.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/memberName"
      }
    },
    "enumerations": {
      "description": "Named sets of values. A value is written qualified, as Condition.DAMAGED.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/typeName"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/definitions/stateName"
        }
      }
    },
    "sequences": {
      "description": "Named counters that mint identifiers (declaration-syntax.md §1, §3.1), by name.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/memberName"
      },
      "additionalProperties": {
        "$ref": "#/definitions/sequence"
      }
    },
    "machines": {
      "description": "State machines several types share, by name (UML StateMachine).",
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/typeName"
      },
      "additionalProperties": {
        "$ref": "#/definitions/machine"
      }
    },
    "types": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/definitions/typeName"
      },
      "additionalProperties": {
        "$ref": "#/definitions/type"
      }
    }
  },
  "definitions": {
    "typeName": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "stateName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "memberName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/memberName"
      }
    },
    "states": {
      "oneOf": [
        {
          "$ref": "#/definitions/stateName"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/stateName"
          }
        }
      ]
    },
    "description": {
      "type": "string",
      "minLength": 3
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+ (s|min|h|days?|weeks?)$"
    },
    "expression": {
      "type": "string",
      "minLength": 1
    },
    "remedy": {
      "enum": [
        "self_serviceable",
        "delegable",
        "temporal",
        "dependent",
        "unreachable_from_here"
      ]
    },
    "type": {
      "type": "object",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/definitions/description",
          "description": "What an object of the type is, in one or more sentences."
        },
        "abstract": {
          "type": "boolean",
          "description": "true for a base that has no objects of its own; the types that extend it inherit its attributes, derived attributes and invariants."
        },
        "extends": {
          "$ref": "#/definitions/typeName",
          "description": "The abstract base this type inherits attributes, derived attributes and invariants from, and its tracking; never its transitions."
        },
        "tracking": {
          "enum": [
            "record",
            "serial",
            "quantity"
          ],
          "description": "record, serial or quantity (declaration-syntax.md §2)."
        },
        "state_machine": {
          "$ref": "#/definitions/typeName",
          "description": "The shared state machine this type binds, declared in the module or imported (UML classifierBehavior); a binder declares no states of its own."
        },
        "states": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/definitions/stateName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/state"
          },
          "description": "The type's states, by name."
        },
        "transitions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/transition"
          },
          "description": "The type's transitions, by name; a transition's name is its trigger."
        },
        "conditions": {
          "description": "Named conditions, used as guards by the transitions.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/condition"
          }
        },
        "derived_attributes": {
          "description": "Attributes whose value is an expression over the object, never written (UML Property::isDerived); each reads only those declared above it.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/derivedAttribute"
          }
        },
        "invariants": {
          "description": "Conditions that hold for every object of the type at all times.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/invariant"
          }
        },
        "attributes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/attribute"
          },
          "description": "The type's attributes, by name."
        },
        "observations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/observation"
          },
          "description": "Datapoints recorded about an object and never changed afterwards, by name."
        },
        "metrics": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/metric"
          },
          "description": "Figures computed from the record of many objects."
        }
      },
      "oneOf": [
        {
          "required": [
            "states",
            "transitions"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "state_machine"
                ]
              },
              {
                "properties": {
                  "abstract": {
                    "const": true
                  }
                },
                "required": [
                  "abstract"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "state_machine"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "states"
                ]
              },
              {
                "properties": {
                  "abstract": {
                    "const": true
                  }
                },
                "required": [
                  "abstract"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "abstract": {
              "const": true
            }
          },
          "required": [
            "abstract"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "state_machine"
                ]
              },
              {
                "required": [
                  "states"
                ]
              },
              {
                "required": [
                  "transitions"
                ]
              },
              {
                "required": [
                  "conditions"
                ]
              },
              {
                "required": [
                  "observations"
                ]
              },
              {
                "required": [
                  "metrics"
                ]
              }
            ]
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "tracking"
          ]
        },
        {
          "required": [
            "extends"
          ]
        },
        {
          "properties": {
            "abstract": {
              "const": true
            }
          },
          "required": [
            "abstract"
          ]
        }
      ]
    },
    "state": {
      "type": "object",
      "required": [
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/definitions/description",
          "description": "What it means for an object to be in the state."
        },
        "category": {
          "$ref": "#/definitions/memberName",
          "description": "One of the module's categories."
        },
        "final": {
          "type": "boolean",
          "description": "No transition leaves this state (UML FinalState)."
        },
        "required_attributes": {
          "$ref": "#/definitions/names",
          "description": "Attributes that have a value whenever an object is in this state."
        }
      }
    },
    "transition": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "initial",
            "external",
            "internal",
            "assertion",
            "erasure"
          ],
          "description": "UML: initial transition, external transition, internal transition. And two with no UML counterpart: assertion, which puts an object into a state the request names, from any state, as an override; erasure, which erases the object's personal attributes at any state."
        },
        "from": {
          "oneOf": [
            {
              "$ref": "#/definitions/states"
            },
            {
              "const": "any"
            }
          ],
          "description": "The source state, or states, or any: every state that is not final. Required for external and internal transitions; absent for an initial one, an assertion and an erasure."
        },
        "to": {
          "$ref": "#/definitions/states",
          "description": "The target state: one for an initial or external transition; for an assertion, the states it may put an object in. Absent for an internal transition and an erasure."
        },
        "description": {
          "$ref": "#/definitions/description",
          "description": "What the transition does, in one sentence."
        },
        "only_via": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*\\.[a-z][a-z0-9_]*$"
          },
          "description": "The transitions, as Type.transition, that alone may take this one, by a call, a create or a cascade; no caller may request it."
        },
        "corrects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/memberName"
          },
          "description": "The attributes this transition corrects: it writes exactly these, and its events carry the corrected provenance."
        },
        "may_admit": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([A-Z][A-Za-z0-9]*\\.)?[a-z][a-z0-9_]*$"
          },
          "description": "On an assertion: the invariants a request may admit breaking, this type's or <Type>.<invariant> of a type reachable by a relationship."
        },
        "required_inputs": {
          "$ref": "#/definitions/names",
          "description": "Attributes the caller must supply; each is written to the attribute of the same name."
        },
        "optional_inputs": {
          "$ref": "#/definitions/names",
          "description": "Attributes the caller may supply; each is written if supplied."
        },
        "inputs": {
          "description": "Declared inputs that write no attribute of their own name, by name; read in expressions as inputs.<name>.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/input"
          }
        },
        "guards": {
          "description": "Conditions evaluated, in this order, after the required inputs are checked.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "enum": [
              "deny",
              "audit",
              "warn"
            ]
          }
        },
        "effect": {
          "description": "The writes the transition makes, in this order (UML Transition::effect).",
          "type": "array",
          "items": {
            "$ref": "#/definitions/step"
          }
        },
        "backdating_limit": {
          "$ref": "#/definitions/duration",
          "description": "How far in the past a caller may say the change happened."
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "initial"
            },
            "to": {
              "$ref": "#/definitions/stateName"
            }
          },
          "required": [
            "to"
          ],
          "not": {
            "required": [
              "from"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "external"
            },
            "to": {
              "$ref": "#/definitions/stateName"
            }
          },
          "required": [
            "from",
            "to"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "internal"
            }
          },
          "required": [
            "from"
          ],
          "not": {
            "required": [
              "to"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "assertion"
            }
          },
          "required": [
            "to"
          ],
          "not": {
            "required": [
              "from"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "erasure"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "from"
                ]
              },
              {
                "required": [
                  "to"
                ]
              }
            ]
          }
        }
      ]
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "assign"
          ],
          "additionalProperties": false,
          "properties": {
            "assign": {
              "type": "object",
              "required": [
                "location",
                "expr"
              ],
              "additionalProperties": false,
              "properties": {
                "location": {
                  "$ref": "#/definitions/memberName"
                },
                "expr": {
                  "$ref": "#/definitions/expression"
                }
              },
              "description": "Writes the value of expr to the attribute named by location (SCXML <assign>)."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "clear"
          ],
          "additionalProperties": false,
          "properties": {
            "clear": {
              "$ref": "#/definitions/names",
              "description": "Removes the values of the listed optional attributes."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "add"
          ],
          "additionalProperties": false,
          "properties": {
            "add": {
              "type": "object",
              "required": [
                "location",
                "expr"
              ],
              "additionalProperties": false,
              "properties": {
                "location": {
                  "$ref": "#/definitions/memberName"
                },
                "expr": {
                  "$ref": "#/definitions/expression"
                }
              },
              "description": "Adds the value of expr to the set-valued attribute named by location."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "remove"
          ],
          "additionalProperties": false,
          "properties": {
            "remove": {
              "type": "object",
              "required": [
                "location",
                "expr"
              ],
              "additionalProperties": false,
              "properties": {
                "location": {
                  "$ref": "#/definitions/memberName"
                },
                "expr": {
                  "$ref": "#/definitions/expression"
                }
              },
              "description": "Removes the value of expr from the set-valued attribute named by location."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "call"
          ],
          "additionalProperties": false,
          "properties": {
            "call": {
              "type": "object",
              "required": [
                "target",
                "transition"
              ],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "$ref": "#/definitions/expression"
                },
                "transition": {
                  "$ref": "#/definitions/memberName"
                },
                "inputs": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/definitions/memberName"
                  },
                  "additionalProperties": {
                    "$ref": "#/definitions/expression"
                  },
                  "description": "The inputs passed to the transition, each an expression."
                }
              },
              "description": "Takes a transition of another object, which evaluates its guards and records its own event (UML CallOperationAction)."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "create"
          ],
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "object",
              "required": [
                "type",
                "transition"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "$ref": "#/definitions/typeName"
                },
                "transition": {
                  "$ref": "#/definitions/memberName"
                },
                "inputs": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/definitions/memberName"
                  },
                  "additionalProperties": {
                    "$ref": "#/definitions/expression"
                  },
                  "description": "The inputs passed to the transition, each an expression."
                },
                "result": {
                  "$ref": "#/definitions/memberName"
                }
              },
              "description": "Creates an object by an initial transition of its type; result names it for later steps (UML CreateObjectAction)."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "foreach"
          ],
          "additionalProperties": false,
          "properties": {
            "foreach": {
              "type": "object",
              "required": [
                "item",
                "limit",
                "steps"
              ],
              "additionalProperties": false,
              "properties": {
                "item": {
                  "$ref": "#/definitions/memberName"
                },
                "array": {
                  "$ref": "#/definitions/expression"
                },
                "range": {
                  "$ref": "#/definitions/expression"
                },
                "where": {
                  "$ref": "#/definitions/expression"
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1
                },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/definitions/step"
                  }
                }
              },
              "oneOf": [
                {
                  "required": [
                    "array"
                  ],
                  "not": {
                    "required": [
                      "range"
                    ]
                  }
                },
                {
                  "required": [
                    "range"
                  ],
                  "not": {
                    "required": [
                      "array"
                    ]
                  }
                }
              ],
              "description": "Runs steps for each element of array, or for each number from 1 to range, at most limit times (SCXML <foreach>)."
            }
          }
        }
      ]
    },
    "condition": {
      "type": "object",
      "required": [
        "description",
        "expression",
        "remedy"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/definitions/description",
          "description": "The condition, stated as what holds when it is satisfied."
        },
        "expression": {
          "$ref": "#/definitions/expression",
          "description": "The condition in the expression language (declaration-syntax.md §8)."
        },
        "remedy": {
          "$ref": "#/definitions/remedy",
          "description": "What a caller can do when the condition fails (DESIGN.md §5.5)."
        }
      }
    },
    "invariant": {
      "type": "object",
      "required": [
        "description",
        "expression"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/definitions/description",
          "description": "The invariant, stated as what always holds."
        },
        "expression": {
          "$ref": "#/definitions/expression",
          "description": "The invariant in the expression language."
        }
      }
    },
    "derivedAttribute": {
      "type": "object",
      "required": [
        "description",
        "expression"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/definitions/description",
          "description": "What the value is."
        },
        "expression": {
          "$ref": "#/definitions/expression",
          "description": "The value, in the expression language (declaration-syntax.md §8); its type is the expression's."
        },
        "indexed": {
          "type": "boolean",
          "description": "Queries may filter on it; it then reads only this object's indexed attributes, single references and state, and no clock (declaration-syntax.md §7, check 46)."
        }
      }
    },
    "sequence": {
      "type": "object",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/definitions/description",
          "description": "What the sequence numbers."
        }
      }
    },
    "identifier": {
      "type": "object",
      "required": [
        "sequence",
        "format"
      ],
      "additionalProperties": false,
      "description": "The value is minted from a sequence when the object is created.",
      "properties": {
        "sequence": {
          "$ref": "#/definitions/memberName",
          "description": "The sequence the number is taken from, declared in the module or imported."
        },
        "scope": {
          "$ref": "#/definitions/memberName",
          "description": "A reference, or an indexed attribute, that every creation writes; the sequence numbers each of its values separately."
        },
        "format": {
          "type": "string",
          "description": "The text minted: {n} or {n:<width>} for the number, {<attribute>} or {<reference>.<attribute>} for a string or enumeration value, and [ … ] around a segment left out when a value inside it is absent."
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\([A-Za-z0-9, ]+\\))?(\\[\\])?$",
          "description": "A built-in type (string, bool, int, decimal(p,s), money(ccy), timestamp, duration, identity, file) or an enumeration's name."
        },
        "reference": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*(\\[\\])?$",
          "description": "The type of object this attribute names, declared in the module or imported; [] makes it a set."
        },
        "opposite": {
          "$ref": "#/definitions/memberName",
          "description": "The attribute of the referenced type that is the other end of this relationship (UML Property::opposite)."
        },
        "stored": {
          "type": "boolean",
          "description": "On one of two single ends: this end holds the value, and the other is read from it."
        },
        "aggregation": {
          "enum": [
            "composite"
          ],
          "description": "composite: the referenced objects are parts of this one, exclusively and for no longer than it (UML AggregationKind::composite)."
        },
        "cascade": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/cascadeClause"
          },
          "description": "On a composite end: the transition each part takes when this object takes one of the listed transitions."
        },
        "survives": {
          "oneOf": [
            {
              "const": true
            },
            {
              "$ref": "#/definitions/names"
            }
          ],
          "description": "On a composite end: true if the parts outlive every final transition of this object, or the transitions they outlive."
        },
        "description": {
          "$ref": "#/definitions/description",
          "description": "What the attribute holds, where the name alone does not say."
        },
        "optional": {
          "type": "boolean",
          "description": "true if the attribute may be without a value."
        },
        "identifier": {
          "$ref": "#/definitions/identifier"
        },
        "unique": {
          "description": "No two objects hold the same value: true across the type; in_scope, per the identifier's scope; with, together with the attributes listed; where, among the objects the expression holds for.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "const": "in_scope"
            },
            {
              "type": "object",
              "required": [
                "with"
              ],
              "additionalProperties": false,
              "properties": {
                "with": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/definitions/memberName"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "where"
              ],
              "additionalProperties": false,
              "properties": {
                "where": {
                  "$ref": "#/definitions/expression"
                }
              }
            }
          ]
        },
        "indexed": {
          "type": "boolean"
        },
        "personal": {
          "type": "boolean"
        },
        "actor_kind": {
          "enum": [
            "human",
            "agent",
            "service"
          ],
          "description": "On an identity attribute: the kind of actor objects of this type are."
        },
        "assignee": {
          "type": "boolean",
          "description": "On a reference: it names who is responsible for the object."
        },
        "unit": {
          "type": "string",
          "description": "On an observation's attribute: the unit of the measured value."
        }
      },
      "oneOf": [
        {
          "required": [
            "type"
          ]
        },
        {
          "required": [
            "reference"
          ]
        }
      ]
    },
    "observation": {
      "type": "object",
      "required": [
        "kind",
        "description",
        "attributes"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/definitions/typeName",
          "description": "The observation kind's name."
        },
        "description": {
          "$ref": "#/definitions/description"
        },
        "attributes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/attribute"
          }
        },
        "max_recording_delay": {
          "$ref": "#/definitions/duration",
          "description": "How long after the fact a datapoint may still be recorded."
        },
        "invariants": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/invariant"
          }
        }
      }
    },
    "metric": {
      "oneOf": [
        {
          "$ref": "#/definitions/measureMetric"
        },
        {
          "$ref": "#/definitions/formulaMetric"
        }
      ]
    },
    "measureMetric": {
      "type": "object",
      "required": [
        "description",
        "measure"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/definitions/description"
        },
        "measure": {
          "enum": [
            "median_time_in_state",
            "transition_count"
          ],
          "description": "median_time_in_state of a state, or transition_count of a transition."
        },
        "state": {
          "$ref": "#/definitions/stateName"
        },
        "transition": {
          "$ref": "#/definitions/memberName"
        },
        "group_by": {
          "$ref": "#/definitions/names",
          "description": "month, week, actor, or an attribute of the type."
        },
        "flag_when": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/expression"
          },
          "description": "Named flags, each an expression over value and the dimensions."
        }
      },
      "oneOf": [
        {
          "properties": {
            "measure": {
              "const": "median_time_in_state"
            }
          },
          "required": [
            "state"
          ],
          "not": {
            "required": [
              "transition"
            ]
          }
        },
        {
          "properties": {
            "measure": {
              "const": "transition_count"
            }
          },
          "required": [
            "transition"
          ],
          "not": {
            "required": [
              "state"
            ]
          }
        }
      ],
      "description": "A fixed measure: the median time in a state, or the number of times a transition is taken."
    },
    "formulaMetric": {
      "type": "object",
      "description": "A metric written in the model's metric language (declaration-syntax.md §6.9): an expression aggregated over the rows of a source, grouped by dimensions.",
      "required": [
        "description",
        "source",
        "item",
        "expression"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/definitions/description"
        },
        "source": {
          "description": "The rows: objects, intervals, intervals(<member>), transitions, attempts, attempt_counts, or an observation kind of the type.",
          "anyOf": [
            {
              "enum": [
                "objects",
                "intervals",
                "transitions",
                "attempts",
                "attempt_counts"
              ]
            },
            {
              "type": "string",
              "pattern": "^intervals\\([a-z][a-z0-9_]*\\)$"
            },
            {
              "$ref": "#/definitions/memberName",
              "description": "An observation kind of the type."
            }
          ]
        },
        "item": {
          "$ref": "#/definitions/memberName",
          "description": "The name each row is read by."
        },
        "filter": {
          "$ref": "#/definitions/expression",
          "description": "The rows counted: those the expression holds for (dbt's filter, a WHERE clause)."
        },
        "dimensions": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/expression"
          },
          "description": "The groups: a mapping from a dimension's name to an expression over the row."
        },
        "time_dimension": {
          "$ref": "#/definitions/expression",
          "description": "The timestamp a window over last <duration> selects rows by."
        },
        "expression": {
          "$ref": "#/definitions/expression",
          "description": "The value, aggregated over the rows of one group."
        },
        "flag_when": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/expression"
          },
          "description": "Named flags, each an expression over value and the dimensions."
        }
      }
    },
    "input": {
      "description": "A value the caller supplies with a request, recorded with the event and written only where an effect writes it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\([A-Za-z0-9, ]+\\))?(\\[\\])?$",
          "description": "A built-in type or an enumeration's name; [] makes the input a set."
        },
        "reference": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*(\\[\\])?$",
          "description": "The type of object the input names; [] makes it a set of objects."
        },
        "optional": {
          "type": "boolean",
          "description": "true if the caller may leave the input out."
        },
        "personal": {
          "type": "boolean",
          "description": "true if erasure redacts the input from every event that recorded it."
        },
        "default": {
          "$ref": "#/definitions/expression",
          "description": "The value used when the caller leaves the input out; not allowed on an optional input."
        },
        "description": {
          "$ref": "#/definitions/description"
        }
      },
      "oneOf": [
        {
          "required": [
            "type"
          ]
        },
        {
          "required": [
            "reference"
          ]
        }
      ]
    },
    "cascadeClause": {
      "type": "object",
      "required": [
        "on",
        "transition",
        "limit"
      ],
      "additionalProperties": false,
      "properties": {
        "on": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/memberName"
          },
          "description": "The transitions of this object that drive the cascade."
        },
        "transition": {
          "$ref": "#/definitions/memberName",
          "description": "The transition each part takes."
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/expression"
          },
          "description": "The inputs passed to each part's transition, each an expression over this object and the triggering transition's inputs."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "The most parts the cascade may reach in one request."
        }
      }
    },
    "machine": {
      "type": "object",
      "required": [
        "description",
        "states",
        "transitions"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/definitions/description"
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "description": "What a type that binds this machine must declare.",
          "properties": {
            "attributes": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/definitions/memberName"
              },
              "additionalProperties": {
                "$ref": "#/definitions/attribute"
              },
              "description": "The attributes the machine's conditions and effects read or write, as a binder must declare them."
            },
            "invariants": {
              "$ref": "#/definitions/names",
              "description": "The invariants a binder must declare."
            }
          }
        },
        "states": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/definitions/stateName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/state"
          },
          "description": "The type's states, by name."
        },
        "conditions": {
          "description": "Named conditions, used as guards by the transitions.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/condition"
          }
        },
        "transitions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/definitions/memberName"
          },
          "additionalProperties": {
            "$ref": "#/definitions/transition"
          },
          "description": "The type's transitions, by name; a transition's name is its trigger."
        }
      }
    }
  }
}
